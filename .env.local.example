# 이 파일을 복사해 .env.local로 저장한 뒤 실제 값을 채워 넣으세요.
# .env.local은 .gitignore(*.local)에 의해 Git에 커밋되지 않습니다.

# Gemini API 키 (필수) — https://aistudio.google.com/apikey 에서 발급
VITE_GEMINI_API_KEY=

# 센터(기관) 전화번호 (선택) — 설정하지 않으면 센터 연락 버튼이 표시되지 않습니다
VITE_CENTER_PHONE_NUMBER=

# Google Analytics 4 측정 ID (선택)
VITE_GA_MEASUREMENT_ID=

# 공공데이터포털 "국민건강보험공단_장기요양기관 검색 서비스" 인증키 (선택, 서버 전용)
# VITE_ 접두사가 없으므로 브라우저로 노출되지 않고 api/ 서버리스 함수에서만 사용됩니다.
DATA_GO_KR_SERVICE_KEY=

# ── 60초 AI 돌봄보고 (CARE REPORT) 실증 파일럿 · /care, /admin ──────────
# 아래 값은 모두 서버(api/ 서버리스 함수) 전용입니다. VITE_ 접두사가 없으므로
# 브라우저 번들에 절대 포함되지 않습니다.

# Supabase 프로젝트 URL과 Service Role 키 (필수) — Supabase 대시보드 > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 참여자(요양보호사)·관리자 세션 쿠키(JWT) 서명 비밀키 (필수)
# 아무 값이나 32자 이상의 무작위 문자열을 사용하세요. 예: openssl rand -hex 32
CARE_PILOT_JWT_SECRET=

# 관리자 로그인 비밀번호의 bcrypt 해시 (필수, 평문 비밀번호를 저장하지 않습니다)
# 발급 방법: node -e "require('bcryptjs').hash(process.argv[1],10).then(console.log)" '원하는비밀번호'
CARE_PILOT_ADMIN_PASSWORD_HASH=

# 돌봄보고 AI 질문·구조화에 사용하는 Gemini API 키 (필수, 서버 전용)
# https://aistudio.google.com/apikey 에서 발급. 브라우저용 VITE_GEMINI_API_KEY와는 별개입니다.
GEMINI_API_KEY=

# 실증 기간 (선택, 기본값 2026-09-07 ~ 2026-09-18) — 관리자 대시보드 참여현황표/기간 표시에 사용
CARE_PILOT_START_DATE=2026-09-07
CARE_PILOT_END_DATE=2026-09-18
