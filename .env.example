# Server-only values. Do not enter a Google login password in any of these fields.
# CARE_AI_PROVIDER: blank/auto preserves automatic routing; gemini or vertex pins one route.
# CARE_AI_MODEL: blank preserves the existing model. Availability must be verified separately.
CARE_AI_PROVIDER=
CARE_AI_MODEL=
GEMINI_API_KEY=
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=
GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=

# Explicit server opt-in for source text extraction (no browser key exposure)
CENTER_PERSON_IMPORT_AI_ENABLED=false
